############################
.pytest_cache/
.mypy_cache/
.idea/
*.swp

############################
# Encrypted update payloads (SecureStore / DP output) - never commit
############################
*.enc
*.pt.enc

############################
# Immutable local backup of the frozen dataset - never commit, never delete
############################
dataset_build/daic_records_multimodal.parquet.ORIGINAL.bak

############################
# DAIC-WOZ derived build artifacts - not raw data, but derived from the
# licensed corpus (participant IDs, coverage stats, digests of the
# restricted parquet). Never read by live runtime code - only produced/
# consumed by the one-time dataset-build scripts at repo root. dataset_build/
# itself is NOT ignored - it's where the supplied parquet must be placed.
############################
dataset_build/*.json

############################
# Repo-local mirror of one client session's XAI/receipt artifacts, derived
# from DAIC-WOZ (real participant ID + label + transcript token excerpts).
# Never read by live code - always reads the external
# ~/.federated/data/anchor_session_backups/ copy instead (see
# scripts/demo_predictions.py). This repo mirror is presentation-history
# only and must not be pushed to a new remote.
############################
anchor_session_backups/
